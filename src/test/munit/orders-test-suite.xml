    <munit:config name="orders-test-suite.xml"/>

    <!-- ===================== INTAKE FLOW TESTS ===================== -->

    <munit:test name="intake-accepts-new-order-test"
                description="New order is stored, published to JMS and answered with 202 RECEIVED">
        <munit:behavior>
            <ee:transform doc:name="Set order payload">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    orderId: "ORD-T-0001",
    orderDate: "2026-10-14T15:30:00+05:30",
    customer: {
        customerId: "CUST101",
        name: "Test Customer",
        email: "test@example.com"
    },
    items: [
        { productId: "PROD101", productName: "Laptop", quantity: 2, unitPrice: 500 }
    ],
    shippingAddress: {
        addressLine1: "12 Main Street",
        city: "Mysuru",
        state: "Karnataka",
        postalCode: "570001",
        country: "India"
    },
    paymentMethod: "CARD",
    currency: "INR",
    totalAmount: 1000
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
            <munit-tools:mock-when processor="os:store">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[null]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="jms:publish">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[null]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="post:\orders:application\json:orders-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.status]"
                                     is="#[MunitTools::equalTo('RECEIVED')]"
                                     message="Status should be RECEIVED"/>
            <munit-tools:assert-that expression="#[payload.orderId]"
                                     is="#[MunitTools::equalTo('ORD-T-0001')]"
                                     message="Order ID should be echoed back"/>
            <munit-tools:assert-that expression="#[vars.httpStatus == 202]"
                                     is="#[MunitTools::equalTo(true)]"
                                     message="HTTP status should be 202"/>
            <munit-tools:verify-call processor="os:store" times="1"/>
            <munit-tools:verify-call processor="jms:publish" times="1"/>
        </munit:validation>
    </munit:test>

    <munit:test name="intake-rejects-duplicate-order-test"
                description="Duplicate order ID returns 409 and nothing is published">
        <munit:behavior>
            <ee:transform doc:name="Set order payload">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    orderId: "ORD-T-0002",
    items: [
        { productId: "PROD101", productName: "Laptop", quantity: 1, unitPrice: 500 }
    ],
    totalAmount: 500
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
            <munit-tools:mock-when processor="os:store">
                <munit-tools:then-return>
                    <munit-tools:error typeId="OS:KEY_ALREADY_EXISTS"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="jms:publish">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[null]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="post:\orders:application\json:orders-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.error]"
                                     is="#[MunitTools::equalTo('DUPLICATE_ORDER')]"
                                     message="Error should be DUPLICATE_ORDER"/>
            <munit-tools:assert-that expression="#[vars.httpStatus == 409]"
                                     is="#[MunitTools::equalTo(true)]"
                                     message="HTTP status should be 409"/>
            <munit-tools:verify-call processor="jms:publish" times="0"/>
        </munit:validation>
    </munit:test>

    <munit:test name="intake-publish-failure-removes-marker-test"
