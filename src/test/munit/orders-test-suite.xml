    <!-- ===================== CONSUMER FLOW TESTS ===================== -->

    <munit:test name="consumer-saves-valid-order-test"
                description="Valid order with 2 items is saved, email sent, email status updated">
        <munit:behavior>
            <ee:transform doc:name="Set order payload">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    orderId: "ORD-T-1001",
    orderDate: "2026-10-14T15:30:00+05:30",
    customer: {
        customerId: "CUST101",
        name: "Test Customer",
        email: "test@example.com",
        phone: "9999999999"
    },
    items: [
        { productId: "PROD101", productName: "Laptop", quantity: 2, unitPrice: 500 },
        { productId: "PROD102", productName: "Mouse", quantity: 1, unitPrice: 25.50 }
    ],
    shippingAddress: {
        addressLine1: "12 Main Street",
        city: "Mysuru",
        state: "Karnataka",
        postalCode: "570001",
        country: "India"
    },
    paymentMethod: "CARD",
    currency: "INR",
    totalAmount: 1025.50
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
            <munit-tools:mock-when processor="db:insert">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[null]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:update">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[null]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="email:send">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[null]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="jms:publish">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[null]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="orders-consumer"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.orderRecord.amountMatches]"
                                     is="#[MunitTools::equalTo(true)]"
                                     message="Order total should match"/>
            <munit-tools:assert-that expression="#[vars.orderRecord.calculatedTotal == 1025.5]"
                                     is="#[MunitTools::equalTo(true)]"
                                     message="Calculated total should be 1025.50"/>
            <munit-tools:assert-that expression="#[vars.orderRecord.customerName]"
                                     is="#[MunitTools::equalTo('Test Customer')]"
                                     message="Customer name should come from customer.name"/>
            <munit-tools:assert-that expression="#[vars.orderRecord.city]"
                                     is="#[MunitTools::equalTo('Mysuru')]"
                                     message="City should come from shippingAddress.city"/>
            <munit-tools:verify-call processor="db:insert" times="3"/>
            <munit-tools:verify-call processor="email:send" times="1"/>
            <munit-tools:verify-call processor="db:update" times="1"/>
            <munit-tools:verify-call processor="jms:publish" times="0"/>
        </munit:validation>
    </munit:test>

