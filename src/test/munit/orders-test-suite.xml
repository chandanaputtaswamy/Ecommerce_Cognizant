                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    orderId: "ORD-T-0004",
    items: [
        { productId: "PROD101", productName: "Laptop", quantity: 1, unitPrice: 500 }
    ],
    totalAmount: 500
}]]></ee:set-payload>
