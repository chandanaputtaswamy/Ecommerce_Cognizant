            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <try>
                <flow-ref name="orders-main"/>
                <error-handler>
                    <on-error-continue type="ANY"/>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.httpStatus == 400]"
                                     is="#[MunitTools::equalTo(true)]"
