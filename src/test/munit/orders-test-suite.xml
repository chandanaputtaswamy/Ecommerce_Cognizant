            <munit-tools:verify-call processor="apikit:router" times="1"/>
        </munit:validation>
    </munit:test>

    <munit:test name="main-bad-request-returns-400-test"
                description="APIKIT:BAD_REQUEST is mapped to 400 VALIDATION_ERROR">
        <munit:behavior>
